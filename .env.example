# -----------------------------------------------------------------------------
# データベース接続設定 (Database Connection)
# -----------------------------------------------------------------------------
# PostgreSQL の接続 URL を指定します。
# 書式: postgresql://[ユーザー名]:[パスワード]@[ホスト名]:[ポート番号]/[データベース名]?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/reservation_db?schema=public"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth) 認証設定 (Authentication)
# -----------------------------------------------------------------------------
# セッション暗号化用のランダムな文字列（シークレットキー）です。
# 本番環境やローカルでは `npx auth secret` や `openssl rand -base64 32` で生成した値を設定します。
AUTH_SECRET="your-nextauth-secret-key-here"

# 本番環境（Vercel等）へデプロイする場合のアプリのベースURL（ローカル開発時は自動認識されるためコメントアウト可）
# NEXTAUTH_URL="http://localhost:3000"